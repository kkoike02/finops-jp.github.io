{
  "name": "Regression Check on Fix",
  "version": "1.0.0",
  "description": "設定ファイル変更時にlint・テスト・型チェックを自動実行",
  "when": {
    "type": "fileEdited",
    "patterns": ["*.config.ts", "*.config.js", "tsconfig.json", "package.json"]
  },
  "then": {
    "type": "runCommand",
    "command": "npx tsc --noEmit 2>&1 & npm run lint 2>&1 & npm test -- --run 2>&1 || echo REGRESSION_CHECK_FAILED"
  }
}